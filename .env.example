# Copy this file to ".env" and fill in ONE of the two options.

# Option 1 (recommended): the "jwt_token" cookie from your logged-in browser session
DUOLINGO_JWT=

# Option 2 (fallback, often blocked by Duolingo's bot protection)
DUOLINGO_USER=
DUOLINGO_PASS=

# Optional overrides
# DUOLINGO_OUTPUT_DIR=data
# DUOLINGO_BODY_FILE=request_body.json
